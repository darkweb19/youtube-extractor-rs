# Required: generate a random token with at least 32 characters; never commit it.
API_TOKEN=
# Development only; production startup requires API_TOKEN.
ALLOW_UNAUTHENTICATED=false
PORT=8080
# Local: ./data; Docker/Railway: /data backed by a persistent volume.
DATA_DIR=./data
WORKERS=2
QUEUE_CAPACITY=16
MAX_JOBS=256
MAX_DOWNLOAD_BYTES=1073741824
MAX_STORAGE_BYTES=8589934592
JOB_TTL_SECS=3600
CONNECT_TIMEOUT_SECS=10
REQUEST_TIMEOUT_SECS=30
DOWNLOAD_TIMEOUT_SECS=1800
FFMPEG_PATH=ffmpeg
REQUESTS_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=32
RUST_LOG=info

# Worker bundle uses BIND_HOST=127.0.0.1; remote mode is opt-in on Railway.
BIND_HOST=0.0.0.0
EXTRACTOR_MODE=local
# Remote mode: use HTTPS Cloudflare Tunnel/Access and a scoped Google service account.
# GCP_PROJECT_ID=
# GCP_ZONE=
# GCP_INSTANCE_NAME=
# GCP_SERVICE_ACCOUNT_JSON=
# GCP_WORKER_URL=https://worker.example.com
# GCP_WORKER_TOKEN=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# GCP_IDLE_TIMEOUT_SECS=300
# GCP_START_TIMEOUT_SECS=300

# Optional worker no-progress timeout (must be 30..=1800 sec).
STALL_TIMEOUT_SECS=180

# Remote mode: maximum extraction attempts, including the first.
GCP_MAX_JOB_ATTEMPTS=2
