  {
    "id": "metadata-adaptive-private",
    "source": "src/ytdlp.rs active metadata adapter; adaptive streams normalize and signed URLs stay private",
    "scenario": {
      "kind": "metadata",
      "url": "https://youtu.be/abcdefghijk?si=ignored",
      "stdout": "{\"id\": \"abcdefghijk\", \"title\": \"Synthetic training clip\", \"duration\": 42.75, \"channel\": \"Synthetic creator\", \"formats\": [{\"format_id\": \"136\", \"ext\": \"mp4\", \"vcodec\": \"avc1.4d401f\", \"acodec\": \"none\", \"height\": 720, \"url\": \"https://media.example.invalid/?private-signed-sentinel\"}, {\"format_id\": \"140-20\", \"ext\": \"m4a\", \"vcodec\": \"none\", \"acodec\": \"mp4a.40.2\", \"url\": \"https://media.example.invalid/?private-signed-sentinel\"}, {\"format_id\": \"storyboard\", \"ext\": \"mhtml\", \"vcodec\": \"none\", \"acodec\": \"none\"}]}"
    },
    "expect": {
      "outcome": "success",
      "contains": {
        "id": "abcdefghijk",
        "title": "Synthetic training clip",
        "duration_seconds": 42,
        "formats": [
          {
            "itag": 136,
            "container": "mp4",
            "has_audio": false,
            "has_video": true
          },
          {
            "itag": 140,
            "container": "m4a",
            "has_audio": true,
            "has_video": false
          }
        ]
      }
    }
  },
  {
    "id": "metadata-empty-formats",
    "source": "src/ytdlp.rs; metadata without playable formats remains metadata, not completed media",
    "scenario": {
      "kind": "metadata",
      "url": "https://youtube.com/watch?v=abcdefghijk",
      "stdout": "{\"id\": \"abcdefghijk\", \"title\": \"Unavailable formats\", \"formats\": []}"
    },
    "expect": {
      "outcome": "success",
      "contains": {
        "id": "abcdefghijk",
        "formats": []
      }
    }
  },
  {
    "id": "metadata-mismatched-video",
    "source": "src/ytdlp.rs; subprocess metadata must match requested video and errors omit upstream text",
    "scenario": {
      "kind": "metadata",
      "url": "https://youtu.be/abcdefghijk",
      "stdout": "{\"id\": \"zyxwvutsrqp\", \"title\": \"Synthetic training clip\", \"duration\": 42.75, \"channel\": \"Synthetic creator\", \"formats\": [{\"format_id\": \"136\", \"ext\": \"mp4\", \"vcodec\": \"avc1.4d401f\", \"acodec\": \"none\", \"height\": 720, \"url\": \"https://media.example.invalid/?private-signed-sentinel\"}, {\"format_id\": \"140-20\", \"ext\": \"m4a\", \"vcodec\": \"none\", \"acodec\": \"mp4a.40.2\", \"url\": \"https://media.example.invalid/?private-signed-sentinel\"}, {\"format_id\": \"storyboard\", \"ext\": \"mhtml\", \"vcodec\": \"none\", \"acodec\": \"none\"}]}",
      "exit_code": 0
    },
    "expect": {
      "outcome": "error",
      "code": "PLAYER_CHANGED"
    }
  },
