# Required: generate a random token with at least 32 characters; never commit it.
API_TOKEN=
# Required on all deployments: create from https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
# Optional actor IDs (owner~name), verified input schema per actor required.
APIFY_DOWNLOAD_ACTOR=marielise.dev~youtube-video-downloader
APIFY_METADATA_ACTOR=streamers~youtube-scraper
# Additional exact HTTPS hosts used for Apify actor media redirects (e.g. its R2 storage hostname).
# The API token is NEVER sent to these additional hosts. Default media host: api.apify.com
APIFY_MEDIA_HOSTS=
# Development only; production startup requires API_TOKEN.
ALLOW_UNAUTHENTICATED=false
PORT=8080
# Local: ./data; Docker/Railway: /data backed by a persistent volume.
DATA_DIR=./data
WORKERS=2
QUEUE_CAPACITY=16
MAX_JOBS=256
MAX_DOWNLOAD_BYTES=1073741824
MAX_STORAGE_BYTES=8589934592
JOB_TTL_SECS=3600
CONNECT_TIMEOUT_SECS=10
REQUEST_TIMEOUT_SECS=30
DOWNLOAD_TIMEOUT_SECS=1800
FFMPEG_PATH=ffmpeg
REQUESTS_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=32
RUST_LOG=info
# Public browser generator at /. /api/v1 still requires API_TOKEN.
FRONTEND_ENABLED=true
# Set true behind HTTPS in production (Railway, Render, Fly, or TLS reverse proxy).
# If unset, defaults to true when the resolved public origin is HTTPS.
UI_SECURE_COOKIES=false
# Optional exact external origin if a reverse proxy rewrites Host, e.g. https://video.example.com
# If unset on Railway, uses https://$RAILWAY_PUBLIC_DOMAIN. Set explicitly for custom domains.
# UI_PUBLIC_ORIGIN=
