# Replace API_TOKEN with unique random secret (>=32 characters), matching Railway GCP_WORKER_TOKEN.
API_TOKEN=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PORT=8080
BIND_HOST=127.0.0.1
DATA_DIR=/var/lib/youtube-extractor
WORKERS=2
QUEUE_CAPACITY=16
MAX_JOBS=256
# Five jobs with 1 GiB reservation each fit in this 8 GiB budget.
MAX_DOWNLOAD_BYTES=1073741824
MAX_STORAGE_BYTES=8589934592
JOB_TTL_SECS=3600
DOWNLOAD_TIMEOUT_SECS=1800
YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_JS_RUNTIME=deno
# Direct GCP egress was validated; WARP's current exit returned LOGIN_REQUIRED.
# Optional proxy fallback only after independently validating the exit route:
# YTDLP_PROXY=socks5://127.0.0.1:40000
YTDLP_PROXY_REQUIRED=false
RUST_LOG=info

STALL_TIMEOUT_SECS=180
